# Script to automatically generate PDFs from an ArcGIS Pro Layout for Aerial Images
# Updated 9/21/2026 (Native ArcPy PDF Compilation)

import arcpy
import os
import re

# --- User-defined variables ---
LAYOUT_NAME = "AERIAL-INDEX-LANDSCAPE" 
MAP_FRAME_NAME = "PEI  HISTORICAL AERIAL RESOURCES Map Frame"

SUBJECT_LAYER_OPTIONS = [
    "Subject Property",
    "Subject",
    "SubjectProperty"
]
FINAL_PDF_NAME = "03-AERIALS.pdf"

# Dictionary to map short names/acronyms to their full text
SOURCE_MAPPING = {
    "AMS": "Army Map Service",
    "FSA": "Farm Service Agency",
    "NASA": "NASA Johnson Space Center",
    "AMES": "NASA AMES Research Center",
    "USAF": "U.S. Air Force",
    "NPS": "National Park Service",
    "EROS": "EROS Miscellaneous",
    "AFPO": "USDA-FSA-AFPO",
    "TNRIS": "TNRIS Texas Orthoimagery Program (TOP)"
}
# ------------------------------

def expand_acronyms(text):
    """ Replaces acronyms in the text with their full names from SOURCE_MAPPING. """
    for short_name, full_name in SOURCE_MAPPING.items():
        text = re.sub(fr'(?i)\b{re.escape(short_name)}\b', full_name, text)
    return text

def find_TEXT_ELEMENT(elm_list, srch):
    """ Finds a text element by searching its .text content (case-insensitive). """
    for i in elm_list:
        if re.search(srch, i.text, re.IGNORECASE):
            return i
    return None

def format_aerial_text(lyr_name):
    """ Parses 'YYYY Source', removes 'CIR' tag, maps acronyms, and appends Aerial suffix. """
    match = re.match(r'^(\d{4})\s+(.+)', lyr_name)
    if not match:
        return None
        
    year = match.group(1)
    source = match.group(2).strip()
    
    clean_source = re.sub(r'(?i)\bCIR\b', '', source).strip()
    clean_source = " ".join(clean_source.split())
    clean_source = expand_acronyms(clean_source)
    
    if re.search("(?i)Nearmap", clean_source):
        return f"{year} {clean_source} Aerial Imagery"
    else:
        return f"{year} {clean_source} Aerial Photograph"

def update_subject_symbology(map_obj, layer_name, is_cir):
    """ 
    Updates Subject Property color: 
    If is_cir is True -> Yellow
    If is_cir is False -> Red
    """
    try:
        lyr = map_obj.listLayers(layer_name)[0]
        cim_lyr = lyr.getDefinition('V3')
        
        yellow = [255, 255, 0, 100]
        red = [255, 0, 0, 100]

        target_color = yellow if is_cir else red
        
        for symbol_layer in cim_lyr.renderer.symbol.symbol.symbolLayers:
            if hasattr(symbol_layer, 'color'):
                symbol_layer.color.values = target_color
        
        lyr.setDefinition(cim_lyr)

    except Exception as e:
        print(f"Note: Symbology update skipped: {e}")

# --- Main Script Logic ---

print("Starting Aerial PDF generation...")
p = arcpy.mp.ArcGISProject("CURRENT")

# --- Setup Master PDF with native ArcPy ---
final_pdf_path = os.path.join(os.getcwd(), FINAL_PDF_NAME)
temp_pdf_path = os.path.join(os.getcwd(), "temp_aerial_export.pdf")

# Remove the existing final PDF if it exists
if os.path.exists(final_pdf_path):
    try:
        os.remove(final_pdf_path)
    except PermissionError:
        print(f"ERROR: {FINAL_PDF_NAME} is currently open. Please close it and run the script again.")
        exit()

# Initialize native ArcPy PDF document
pdf_doc = arcpy.mp.PDFDocumentCreate(final_pdf_path)

try:
    layout = p.listLayouts(LAYOUT_NAME)[0]
    mf = layout.listElements("MAPFRAME_ELEMENT", wildcard=MAP_FRAME_NAME)[0]
    m = mf.map
    aerial_txt_elem = find_TEXT_ELEMENT(layout.listElements("TEXT_ELEMENT"), "YEAR")
    
    if not aerial_txt_elem:
        print("ERROR: Could not find text element containing 'YEAR'.")
        exit()
except IndexError:
    print("ERROR: Layout or Map Frame names are incorrect. Check variables at top.")
    exit()

rst_txt = aerial_txt_elem.text 

# --- Filter safe layers ---
safe_layers = []
for lyr in m.listLayers():
    try:
        _ = lyr.name 
        safe_layers.append(lyr)
    except AttributeError:
        continue

# --- Detect Subject Layer ---
active_subject_name = None
lower_options = [opt.lower() for opt in SUBJECT_LAYER_OPTIONS]

for lyr in safe_layers:
    if lyr.name.lower() in lower_options:
        active_subject_name = lyr.name
        break

if not active_subject_name:
    print(f"ERROR: Could not find any layer named {SUBJECT_LAYER_OPTIONS}")
    exit()

print(f"Using Subject Layer: {active_subject_name}")

# Reset layer visibility initially
for lyr in safe_layers:
    if not lyr.isGroupLayer:
        lyr.visible = (lyr.name == active_subject_name)

# --- Main Export Loop ---
for lyr in safe_layers:
    if lyr.isGroupLayer or lyr.name == active_subject_name:
        continue
        
    lname = getattr(lyr, "longName", "")
    if "County Indexes" in lname:
        continue

    formatted_text = format_aerial_text(lyr.name)
    
    if formatted_text:
        is_cir = "CIR" in lyr.name.upper()
        update_subject_symbology(m, active_subject_name, is_cir)
        
        aerial_txt_elem.text = formatted_text
        
        print(f"\nProcessing: {lyr.name}...")
        
        lyr.visible = True
        
        # Export each page to temporary PDF
        layout.exportToPDF(
            out_pdf=temp_pdf_path,
            resolution=400,
            image_quality="BETTER",
            compress_vector_graphics=True,
            image_compression="ADAPTIVE",
            jpeg_compression_quality=85,
            georef_info=True
        )        

        # Append temporary PDF page directly using ArcPy
        pdf_doc.appendPages(temp_pdf_path)
        print(f" -> Appended to {FINAL_PDF_NAME}")
        
        lyr.visible = False

# --- FINAL RESET & CLEANUP ---
aerial_txt_elem.text = rst_txt

print("\nFinalizing: Resetting Subject Property to Red...")
update_subject_symbology(m, active_subject_name, False)

# Save and close master PDF
pdf_doc.saveAndClose()

# Delete temporary export file
if os.path.exists(temp_pdf_path):
    os.remove(temp_pdf_path)

del p
print(f"Finished. All aerials have been compiled into {FINAL_PDF_NAME}")
